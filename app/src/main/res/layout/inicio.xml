<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="#F5F5F5"
              android:padding="16dp">

    <!-- Pantalla de la calculadora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp">

        <!-- Pantalla de operación -->
        <TextView
                android:id="@+id/tvOperation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#666666"
                android:gravity="end"
                android:maxLines="2"
                android:layout_marginBottom="8dp"/>

        <!-- Pantalla de resultado -->
        <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="36sp"
                android:textColor="#000000"
                android:gravity="end"
                android:fontFamily="@font/aclonica"
                android:maxLines="1"
                android:ellipsize="end"/>

    </LinearLayout>

    <!-- Botones de la calculadora -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="6"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- Primera fila: AC, +/-, %, ÷ -->
        <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="AC"
                android:textSize="34sp"
                android:background="@color/design_default_color_error"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>
        <Button
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="%"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>
        <Button
                android:id="@+id/btnPlusMinus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="+/-"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>



        <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="÷"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>

        <!-- Segunda fila: 7, 8, 9, × -->
        <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="7"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="8"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="9"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="×"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>

        <!-- Tercera fila: 4, 5, 6, - -->
        <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="4"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="5"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="6"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="-"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>

        <!-- Cuarta fila: 1, 2, 3, + -->
        <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="1"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="2"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="3"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="+"
                android:textSize="34sp"
                android:background="@drawable/btn_operator"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>

        <!-- Quinta fila: 0 (doble ancho), ., = -->
        <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="0"
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000"
                android:gravity="start|center_vertical"
                android:paddingStart="32dp" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="."
                android:textSize="34sp"
                android:background="@drawable/btn_number"
                android:textColor="#000000" android:fontFamily="@font/alfa_slab_one"/>

        <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="2"
                android:layout_rowWeight="1"
                android:layout_columnSpan="2"
                android:text="="
                android:textSize="34sp"
                android:background="@drawable/btn_equals"
                android:textColor="#FFFFFF" android:fontFamily="@font/alfa_slab_one"/>

    </GridLayout>

</LinearLayout>
